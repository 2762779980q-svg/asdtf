--  HEARTBEAT
-- ════════════════════════════════════════════════════════════════════════════
RunService.Heartbeat:Connect(function()
    local c = char(); if not c or not hrp() then return end
    local r = hrp()
    
    if cframeSpeedEnabled then
        local h = hum()
        if h then
            local moveDir = h.MoveDirection
            if moveDir.Magnitude > 0 then
                r.CFrame = r.CFrame + moveDir.Unit * cframeSpeed * 0.016
            end
        end
    end
    
    if autoBackstabEnabled then
        if autoBackstabSelectedPlayer then
            autoBackstabTarget = Players:FindFirstChild(autoBackstabSelectedPlayer)
        else
            autoBackstabTarget = GetTarget()
        end
    end
    
    if autoBackstabEnabled and autoBackstabTarget then
        local targetChar = autoBackstabTarget.Character
        if targetChar then
            local targetHRP = targetChar:FindFirstChild("HumanoidRootPart")
            if targetHRP then
                local behind = targetHRP.CFrame.Position - targetHRP.CFrame.LookVector * 3
                r.CFrame = CFrame.new(behind, targetHRP.Position)
            end
        end
    end
    
    if faceTargetHorizontal and not autoBackstabEnabled then
        local t = GetTarget()
        if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
            local tp = t.Character.HumanoidRootPart.Position; local mp = r.Position
            local flat = Vector3.new(tp.X, mp.Y, tp.Z); local dir = (flat - mp).Unit
            if dir.Magnitude > 0 then r.CFrame = CFrame.lookAt(mp, mp + dir) end
        end
    end
    
    if faceTargetVertical and not autoBackstabEnabled then
        local t = GetTarget()
        if t and t.Character and t.Character:FindFirstChild("HumanoidRootPart") then
            local tp = t.Character.HumanoidRootPart.Position; local mp = r.Position
            local dir = (tp - mp).Unit
            if dir.Magnitude > 0 then r.CFrame = CFrame.lookAt(mp, mp + dir) end
        end
    end
    
    if floorEnabled and currentFloor and currentFloor.Parent then
        currentFloor.CFrame = CFrame.new(r.Position.X, r.Position.Y - floorOffset, r.Position.Z)
    end
    
    if antiFlyEnabled then
        if r.AssemblyLinearVelocity.Magnitude > 500 then r.AssemblyLinearVelocity = Vector3.zero end
        local h = hum(); if h and h.PlatformStand and not h.Sit then h.PlatformStand = false end
    end
end)

