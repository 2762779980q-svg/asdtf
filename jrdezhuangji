-- 全角色无敌独立线程（0.4秒一次，自动扫描角色名）
task.spawn(function()
    local lastModelName = nil
    while true do
        if autoLoopStates.AllCharInvincible then
            if LP.Character then
                local modelName = nil
                -- 方法1：扫描LocalScript下含Swing的子对象
                for _, child in pairs(LP.Character:GetChildren()) do
                    if child:IsA("LocalScript") then
                        for _, sub in pairs(child:GetChildren()) do
                            if sub.Name == "Swing" then
                                modelName = child.Name
                                break
                            end
                        end
                    end
                    if modelName then break end
                end
                -- 方法2：找不到就找有Animations文件夹的
                if not modelName then
                    for _, child in pairs(LP.Character:GetChildren()) do
                        if child:FindFirstChild("Animations") then
                            modelName = child.Name
                            break
                        end
                    end
                end
                if modelName then
                    if modelName ~= lastModelName then
                        print("全角色无敌扫描到: " .. modelName)
                        Notification.new({ Title = "全角色无敌", Content = "扫描到: " .. modelName, Duration = 2 })
                        lastModelName = modelName
                    end
                    local charModel = LP.Character:FindFirstChild(modelName)
                    if charModel and charModel:FindFirstChild("DestroyCounter") then
                        charModel.DestroyCounter:FireServer(LP)
                    end
                end
            end
        else
            lastModelName = nil
        end
        task.wait(0.4)
    end
end)

