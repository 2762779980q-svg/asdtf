local function addCharTrackedSection(tab, opts)
    local before = {}
    for _, d in ipairs(NeverLose.ScreenGui:GetDescendants()) do
        if d:IsA("Frame") then before[d] = true end
    end
    local sec = tab:AddSection(opts)
    for _, d in ipairs(NeverLose.ScreenGui:GetDescendants()) do
        if d:IsA("Frame") and not before[d] then
            table.insert(charSkillsFrames, d)
        end
    end
    return sec
end

local function clearCharSkills()
    for _, frame in ipairs(charSkillsFrames) do
        pcall(function() frame:Destroy() end)
    end
    charSkillsFrames = {}
    charSkillsSection = nil
end

