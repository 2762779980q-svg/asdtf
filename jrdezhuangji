local function getCharDisplayName(name)
    return characterTranslations[name] or name
end

for charName, remoteList in pairs(allRemotes) do
    local section = AllSkills:AddSection({ Name = getCharDisplayName(charName) })
    scannedSections[charName] = section
    for _, remoteName in ipairs(remoteList) do
        local btnName = getTranslatedName(remoteName)
        local isHitRemote = hitRemotes[remoteName]
        section:AddButton({
            Icon = 'zap',
            Name = btnName,
            Callback = function()
                pcall(function()
                    local chars = RS:FindFirstChild("Characters")
                    if not chars then return end
                    local charFolder = chars:FindFirstChild(charName)
                    if not charFolder then return end
                    local function findRemote(folder)
                        for _, child in ipairs(folder:GetChildren()) do
                            if child.Name == remoteName and (child:IsA("RemoteEvent") or child:IsA("RemoteFunction")) then
                                return child
                            elseif child:IsA("Folder") or child:IsA("Model") then
                                local found = findRemote(child)
                                if found then return found end
                            end
                        end
                        return nil
                    end
                    local remote = findRemote(charFolder)
                    if not remote then return end
                    if isHitRemote then
                        local target = GetTarget()
                        if target and target.Character then
                            Notification.new({ Title = "命中技能", Content = "目标: " .. target.Name, Duration = 1.5 })
                            if remote:IsA("RemoteEvent") then
                                remote:FireServer(target.Character)
                            elseif remote:IsA("RemoteFunction") then
                                remote:InvokeServer(target.Character)
                            end
                        else
                            Notification.new({ Title = "命中技能", Content = "未找到目标", Duration = 1.5 })
                        end
                    else
                        if remote:IsA("RemoteEvent") then
                            remote:FireServer(LP)
                        elseif remote:IsA("RemoteFunction") then
                            remote:InvokeServer(LP)
                        end
                    end
                end)
            end
        })
    end
end

