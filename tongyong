local function isNPC(char)
    if not char or not char:FindFirstChildOfClass("Humanoid") then return false end
    local p = Players:GetPlayerFromCharacter(char)
    return p == nil
end
local function createNPCESPForChar(char)
    if State.npcEspDrawings[char] then removeNPCESPForChar(char) end
    local d = {}
    if State.npcEspSettings.BoxEnabled then d.Box={}; for _,n in ipairs({"Top","Bottom","Left","Right"}) do d.Box[n]=Drawing.new("Line"); d.Box[n].Visible=false; d.Box[n].Thickness=2 end end
    if State.npcEspSettings.TracerEnabled then d.Tracer=Drawing.new("Line"); d.Tracer.Visible=false; d.Tracer.Thickness=1 end
    if State.npcEspSettings.HealthEnabled then d.HealthBar={Background=Drawing.new("Square"),Fill=Drawing.new("Square")}; d.HealthBar.Background.Filled=true; d.HealthBar.Background.Color=Color3.fromRGB(30,30,30); d.HealthBar.Fill.Filled=true end
    if State.npcEspSettings.NameEnabled then d.Name=Drawing.new("Text"); d.Name.Size=14; d.Name.Center=true; d.Name.Outline=true; d.Name.Font=2 end
    if State.npcEspSettings.ShowDistance then d.Distance=Drawing.new("Text"); d.Distance.Size=13; d.Distance.Center=true; d.Distance.Outline=true; d.Distance.Font=2 end
    if State.npcEspSettings.HeadDotEnabled then d.HeadDot=Drawing.new("Circle"); d.HeadDot.Radius=4; d.HeadDot.Filled=true; d.HeadDot.NumSides=32 end
    State.npcEspDrawings[char]=d
end
local function removeNPCESPForChar(char)
    local d=State.npcEspDrawings[char]; if d then for cat,items in pairs(d) do if cat=="Box" or cat=="HealthBar" then for _,o in pairs(items) do pcall(function() o:Remove() end) end else pcall(function() items:Remove() end) end end; State.npcEspDrawings[char]=nil end end
local function hideNPCESPElements(d) if not d then return end; for cat,items in pairs(d) do if cat=="Box" or cat=="HealthBar" then for _,o in pairs(items) do o.Visible=false end else items.Visible=false end end end
local function updateNPCESPForChar(char)
    local d=State.npcEspDrawings[char]; if not d then return end
    if not char.Parent then hideNPCESPElements(d); return end
    local rp=char:FindFirstChild("HumanoidRootPart"); local head=char:FindFirstChild("Head"); local hm=char:FindFirstChildOfClass("Humanoid")
    if not rp or not head or not hm or hm.Health<=0 then hideNPCESPElements(d); return end
    local dist=(rp.Position-camera.CFrame.Position).Magnitude; if dist>State.npcEspMaxDistance then hideNPCESPElements(d); return end
    local hs,ho=worldToScreen(head.Position+Vector3.new(0,0.5,0)); if not ho then hideNPCESPElements(d); return end
    local color=State.npcEspColor; local ext=char:GetExtentsSize(); local ts,_=worldToScreen(head.Position+Vector3.new(0,1.5,0)); local bs,_=worldToScreen(rp.Position-Vector3.new(0,ext.Y/2,0))
    local bh=math.abs(bs.Y-ts.Y); local bw=bh*0.5; local bx=hs.X-bw/2; local by=math.min(ts.Y,bs.Y)
    if d.Box then d.Box.Top.From=Vector2.new(bx,by); d.Box.Top.To=Vector2.new(bx+bw,by); d.Box.Top.Visible=true; d.Box.Top.Color=color
        d.Box.Bottom.From=Vector2.new(bx,by+bh); d.Box.Bottom.To=Vector2.new(bx+bw,by+bh); d.Box.Bottom.Visible=true; d.Box.Bottom.Color=color
        d.Box.Left.From=Vector2.new(bx,by); d.Box.Left.To=Vector2.new(bx,by+bh); d.Box.Left.Visible=true; d.Box.Left.Color=color
        d.Box.Right.From=Vector2.new(bx+bw,by); d.Box.Right.To=Vector2.new(bx+bw,by+bh); d.Box.Right.Visible=true; d.Box.Right.Color=color end
    if d.Tracer then d.Tracer.From=getTracerOrigin(); d.Tracer.To=Vector2.new(bx+bw/2,by+bh); d.Tracer.Visible=true; d.Tracer.Color=color end
    if d.HealthBar then local hp=math.clamp(hm.Health/hm.MaxHealth,0,1); local bw2,bh2=3,bh; local bx2,by2=bx-bw2-3,by
        d.HealthBar.Background.Size=Vector2.new(bw2+2,bh2+2); d.HealthBar.Background.Position=Vector2.new(bx2-1,by2-1); d.HealthBar.Background.Visible=true
        local fh=bh2*hp; d.HealthBar.Fill.Size=Vector2.new(bw2,fh); d.HealthBar.Fill.Position=Vector2.new(bx2,by2+bh2-fh); d.HealthBar.Fill.Visible=true
        if hp>0.6 then d.HealthBar.Fill.Color=State.espColors.HealthHigh elseif hp>0.3 then d.HealthBar.Fill.Color=State.espColors.HealthMedium else d.HealthBar.Fill.Color=State.espColors.HealthLow end end
    if d.Name then local nm=char.Name; d.Name.Text=nm; d.Name.Position=Vector2.new(bx+bw/2,by-20); d.Name.Visible=true; d.Name.Color=color end
    if d.Distance then local dt=string.format("%.0fm",dist/3.571); d.Distance.Text="["..dt.."]"; d.Distance.Position=Vector2.new(bx+bw/2,by+bh+4); d.Distance.Visible=true; d.Distance.Color=color end
    if d.HeadDot then d.HeadDot.Position=hs; d.HeadDot.Visible=ho; d.HeadDot.Color=color end
end
local function startNPCESPLoop()
    if State.npcEspConnection then State.npcEspConnection:Disconnect() end
    State.npcEspConnection=RunService.RenderStepped:Connect(function()
        if State.npcEspEnabled then
