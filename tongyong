end

-- Equip/Unequip Tools
local function equipAllTools()
    local c = char(); if not c then Notification.new({Title = "装备失败", Content = "没有角色", Duration = 2}); return end
    local backpack = player:FindFirstChild("Backpack"); if not backpack then Notification.new({Title = "装备失败", Content = "没有背包", Duration = 2}); return end
    local tools = {}; for _, item in ipairs(backpack:GetChildren()) do if item:IsA("Tool") then table.insert(tools, item) end end
    if #tools == 0 then Notification.new({Title = "背包为空", Content = "没有工具", Duration = 2}); return end
    local count = 0; for _, tool in ipairs(tools) do pcall(function() tool.Parent = c; count = count + 1 end); task.wait(0.05) end
    Notification.new({Title = "装备完成", Content = "装备了 " .. count .. " 个工具", Duration = 2})
