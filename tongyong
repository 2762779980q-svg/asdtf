-- Auto Pickup
local function isPickupable(item)
    if not item or not item:IsA("BasePart") then return false end; if not item:IsDescendantOf(Workspace) then return false end
    for _, bl in ipairs(State.pickupBlacklist) do if item.Name == bl then return false end end
    if item.Anchored then return false end; if item.Parent and item.Parent:IsA("Model") and item.Parent.PrimaryPart == item then return false end
    if item:FindFirstChildOfClass("ProximityPrompt") or item:FindFirstChildOfClass("Tool") or item:FindFirstChildOfClass("ClickDetector") then return true end
    return false
end

local function pickupItem(item)
    if not item or not item.Parent then return end; local r = hrp(); if not r then return end
    if (item.Position - r.Position).Magnitude > State.autoPickupRange then return end
    pcall(function() local prompt = item:FindFirstChildOfClass("ProximityPrompt"); if prompt then prompt:InputHoldBegin(); task.wait(0); prompt:InputHoldEnd(); return end end)
    pcall(function() local cd = item:FindFirstChildOfClass("ClickDetector"); if cd then fireclickdetector(cd); return end end)
    pcall(function() local tool = item:FindFirstChildOfClass("Tool"); if tool and r then local oldPos = r.Position; r.CFrame = CFrame.new(item.Position + Vector3.new(0, 3, 0)); task.wait(0.05); pcall(function() tool.Parent = player.Backpack end); task.wait(0.05); r.CFrame = CFrame.new(oldPos) end end)
end

local function pickupAllInRange()
    local r = hrp(); if not r then return end; local items = {}
    for _, item in ipairs(Workspace:GetDescendants()) do if isPickupable(item) then local dist = (item.Position - r.Position).Magnitude; if dist <= State.autoPickupRange then table.insert(items, {item = item, dist = dist}) end end end
    table.sort(items, function(a, b) return a.dist < b.dist end); local count = 0
    for _, data in ipairs(items) do pickupItem(data.item); count = count + 1 end
    Notification.new({Title = "拾取完成", Content = count > 0 and ("拾取了 " .. count .. " 件") or "无物品", Duration = 2})
end

local function toggleAutoPickup(enabled)
    State.isAutoPickupEnabled = enabled; if State.autoPickupConnection then State.autoPickupConnection:Disconnect(); State.autoPickupConnection = nil end
