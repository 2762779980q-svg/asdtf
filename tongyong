RunService.RenderStepped:Connect(function()
    local st=getgenv().ScriptState; if st.lockEnabled and not st.isLockedOn then acquireLockTarget() end
    if st.lockEnabled and st.isLockedOn and st.targetPlayer and st.targetPlayer.Character then
        if st.aimLockTeamCheck and st.targetPlayer:IsA("Player") and st.targetPlayer.Team==player.Team then st.isLockedOn=false; st.targetPlayer=nil; return end
        if st.aimLockVisibleCheck and not IsPlayerVisible(st.targetPlayer) then st.isLockedOn=false; st.targetPlayer=nil; return end
        local tc=st.targetPlayer:IsA("Player") and st.targetPlayer.Character or st.targetPlayer; local part=tc:FindFirstChild(st.bodyPartSelected or "Head"); local hm=tc:FindFirstChildOfClass("Humanoid")
        if part and hm and hm.Health>0 then local tp=part.Position
            if State.aimAutoPredict then local vel=part.AssemblyLinearVelocity; if vel.Magnitude>1 then tp=tp+(vel*State.aimPredictionAmount) end else tp=tp+(part.AssemblyLinearVelocity*st.predictionFactor) end
            local cp=camera.CFrame.Position; local dlv=(tp-cp).Unit
            if State.aimSmoothEnabled then camera.CFrame=camera.CFrame:Lerp(CFrame.lookAt(cp,cp+dlv),math.clamp(State.aimSmoothSpeed*0.01,0.01,1))
            else if State.aimAntiShakeEnabled then local clv=camera.CFrame.LookVector; local cv=dlv-clv; if cv.Magnitude>0.15 then dlv=clv+cv.Unit*0.15 end end; camera.CFrame=CFrame.lookAt(cp,cp+dlv) end
            State.aimLastTargetTime=tick() else st.isLockedOn=false; st.targetPlayer=nil end end
    if st.lockEnabled and st.isLockedOn and State.aimTargetSwitchEnabled and tick()-State.aimLastTargetTime>0.5 then local _,nt=getClosestPlayer({targetPart=st.bodyPartSelected,visibleCheck=st.aimLockVisibleCheck,aliveCheck=st.aimLockAliveCheck,teamCheck=st.aimLockTeamCheck})
