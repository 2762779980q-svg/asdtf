-- Invisibility
local function startInvisibility()
    State.invisibilityRealChar = char()
    if not State.invisibilityRealChar or not State.invisibilityRealChar:FindFirstChild("HumanoidRootPart") or not State.invisibilityRealChar:FindFirstChildOfClass("Humanoid") then
        Notification.new({Title = "隐身失败", Content = "没有角色", Duration = 2}); return
    end
    State.isInvisibilityEnabled = true; State.invisibilityRealChar.Archivable = true
    local spawnCFrame = State.invisibilityRealChar.HumanoidRootPart.CFrame
    State.invisibilityClone = State.invisibilityRealChar:Clone()
    State.invisibilityClone.Name = player.Name .. "_Ghost"; State.invisibilityClone.Parent = Workspace
    State.invisibilityClone.HumanoidRootPart.CFrame = spawnCFrame
    
    -- 复制动画到克隆角色
    local cloneAnimator = State.invisibilityClone:FindFirstChildOfClass("Animator")
    local realAnimator = State.invisibilityRealChar:FindFirstChildOfClass("Animator")
    if cloneAnimator and realAnimator then
        for _, track in ipairs(realAnimator:GetPlayingAnimationTracks()) do
            if track.Animation then
                local cloneTrack = cloneAnimator:LoadAnimation(track.Animation)
                cloneTrack:Play(); cloneTrack:AdjustSpeed(track.Speed)
                cloneTrack.TimePosition = track.TimePosition
            end
        end
    end
    local realHumanoid = State.invisibilityRealChar:FindFirstChildOfClass("Humanoid")
    local cloneHumanoid = State.invisibilityClone:FindFirstChildOfClass("Humanoid")
    if realHumanoid and cloneHumanoid then
        cloneHumanoid.WalkSpeed = realHumanoid.WalkSpeed
        cloneHumanoid.JumpPower = realHumanoid.JumpPower
    end
    
    -- 高亮本体（倒立在地下）
    local highlight = Instance.new("Highlight")
    highlight.Name = "InvisibilityHighlight"
    highlight.Adornee = State.invisibilityRealChar
    highlight.FillColor = Color3.fromRGB(0, 255, 0)
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
    highlight.OutlineTransparency = 0
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
    highlight.Parent = State.invisibilityRealChar
    State.invisibilityHighlight = highlight
    
    for _, part in ipairs(State.invisibilityClone:GetDescendants()) do
        if part:IsA("BasePart") then part.CanCollide = true; part.Anchored = false end
    end
    
    -- 控制克隆角色（傀儡），本体倒立隐藏
    player.Character = State.invisibilityClone
    camera.CameraSubject = State.invisibilityClone:FindFirstChildOfClass("Humanoid")
    
    State.invisibilityConnection = RunService.Heartbeat:Connect(function()
        if not State.isInvisibilityEnabled or not State.invisibilityRealChar or not State.invisibilityClone then return end
        local cloneHRP = State.invisibilityClone:FindFirstChild("HumanoidRootPart")
        local realHRP = State.invisibilityRealChar:FindFirstChild("HumanoidRootPart")
        for _, part in ipairs(State.invisibilityRealChar:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = false end end
        
        if cloneHRP and realHRP then
            local targetCFrame = cloneHRP.CFrame * CFrame.new(0, State.invisibilityUndergroundOffset, 0) * CFrame.Angles(math.pi, 0, 0)
            if (realHRP.Position - targetCFrame.Position).Magnitude > 0.5 then
                State.invisibilityRealChar:PivotTo(targetCFrame)
            else
                realHRP.CFrame = targetCFrame
            end
            realHRP.AssemblyLinearVelocity = Vector3.zero
            realHRP.AssemblyAngularVelocity = Vector3.zero
        end
        
        -- 持续同步动画到克隆
        local cloneAnimator = State.invisibilityClone:FindFirstChildOfClass("Animator")
        local realAnimator = State.invisibilityRealChar:FindFirstChildOfClass("Animator")
        if cloneAnimator and realAnimator then
            local cloneTracks = cloneAnimator:GetPlayingAnimationTracks()
            local realTracks = realAnimator:GetPlayingAnimationTracks()
            for _, ct in ipairs(cloneTracks) do
                local found = false
                for _, rt in ipairs(realTracks) do
                    if ct.Animation and rt.Animation and ct.Animation.AnimationId == rt.Animation.AnimationId then found = true; break end
                end
                if not found then ct:Stop() end
            end
            for _, rt in ipairs(realTracks) do
                if rt.Animation then
                    local exists = false
                    for _, ct in ipairs(cloneTracks) do
                        if ct.Animation and ct.Animation.AnimationId == rt.Animation.AnimationId then
                            ct:AdjustSpeed(rt.Speed); ct.TimePosition = rt.TimePosition; exists = true; break
                        end
                    end
                    if not exists then
                        local newTrack = cloneAnimator:LoadAnimation(rt.Animation)
                        newTrack:Play(); newTrack:AdjustSpeed(rt.Speed)
                    end
                end
            end
        end
        local realHumanoid = State.invisibilityRealChar:FindFirstChildOfClass("Humanoid")
        local cloneHumanoid = State.invisibilityClone:FindFirstChildOfClass("Humanoid")
        if realHumanoid and cloneHumanoid then
            cloneHumanoid.WalkSpeed = realHumanoid.WalkSpeed
            cloneHumanoid.JumpPower = realHumanoid.JumpPower
        end
        
        if State.invisibilityHighlight then
            local depth = math.abs(State.invisibilityUndergroundOffset)
            if depth <= 10 then State.invisibilityHighlight.FillColor = Color3.fromRGB(0, 255, 0)
            elseif depth <= 20 then State.invisibilityHighlight.FillColor = Color3.fromRGB(255, 255, 0)
            else State.invisibilityHighlight.FillColor = Color3.fromRGB(255, 100, 0) end
        end
    end)
    Notification.new({Title = "隐身", Content = "已开启 | 本体倒立隐藏", Duration = 2})
end

-- stopInvisibility 也需要恢复倒立状态
local function stopInvisibility()
    State.isInvisibilityEnabled = false
    if State.invisibilityConnection then State.invisibilityConnection:Disconnect(); State.invisibilityConnection = nil end
    if State.invisibilityHighlight then State.invisibilityHighlight:Destroy(); State.invisibilityHighlight = nil end
    if State.invisibilityRealChar and State.invisibilityRealChar.Parent then
        player.Character = State.invisibilityRealChar
        camera.CameraSubject = State.invisibilityRealChar:FindFirstChildOfClass("Humanoid")
        if State.invisibilityClone and State.invisibilityClone:FindFirstChild("HumanoidRootPart") and State.invisibilityRealChar:FindFirstChild("HumanoidRootPart") then
            State.invisibilityRealChar:PivotTo(State.invisibilityClone:FindFirstChild("HumanoidRootPart").CFrame)
        end
        for _, part in ipairs(State.invisibilityRealChar:GetDescendants()) do if part:IsA("BasePart") then part.CanCollide = true end end
    end
    if State.invisibilityClone then State.invisibilityClone:Destroy(); State.invisibilityClone = nil end
    Notification.new({Title = "隐身", Content = "已关闭", Duration = 2})
end

