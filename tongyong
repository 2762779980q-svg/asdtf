local function getPositionOnScreen(Vector)
    local v,o=camera:WorldToScreenPoint(Vector); return Vector2.new(v.X,v.Y),o
end

local function IsPlayerVisible(Player)
    local pc=Player and Player.Character; local lc=player.Character
    if not (pc and lc) then return false end
    local tp=pc:FindFirstChild(getgenv().ScriptState.bodyPartSelected or "Head") or pc:FindFirstChild("HumanoidRootPart")
    if not tp then return false end
    return #camera:GetPartsObscuringTarget({tp.Position,lc,pc},{lc,pc})==0
end

local function getClosestPlayer(config)
    local st=getgenv().ScriptState; config=config or {}
    local tpo=config.targetPart or st.bodyPartSelected or "Head"
    local vc=config.visibleCheck or st.aimLockVisibleCheck or false
    local ac=config.aliveCheck or st.aimLockAliveCheck or false
    local tc=config.teamCheck or st.aimLockTeamCheck or false
    local cp, cpl, dtm
    local origin = State.aimFovFollowMouse and UIS:GetMouseLocation() or Vector2.new(camera.ViewportSize.X/2, camera.ViewportSize.Y/2)
    for _,p in next,Players:GetPlayers() do
        if p==player then continue end; if tc and playersOnSameTeam(p) then continue end
        if vc and not IsPlayerVisible(p) then continue end
        local ch=p.Character; if not ch then continue end
        local h=ch:FindFirstChild("HumanoidRootPart"); local hm=ch:FindFirstChild("Humanoid")
        if not h or not hm then continue end; if ac and hm.Health<=0 then continue end
        local sp,on=getPositionOnScreen(h.Position); if not on then continue end
        if State.aimFovEnabled then if (sp-origin).Magnitude>State.aimFovRadius then continue end end
        local d=(origin-sp).Magnitude
        if d<=(dtm or 2000) then local cpt=ch:FindFirstChild(tpo); if cpt then cp=cpt; cpl=p; dtm=d end end
    end
    return cp,cpl
end

local function getNearestPlayer3D()
    local nearest = nil; local minDist = math.huge; local lc = char()
    if not lc then return nil end; local lpos = lc:GetPivot().Position
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end; local tc = p.Character; if not tc then continue end
        local h = tc:FindFirstChildOfClass("Humanoid"); if not h or h.Health <= 0 then continue end
        local rp = tc:FindFirstChild("HumanoidRootPart"); if not rp then continue end
        local dist = (rp.Position - lpos).Magnitude
        if dist < minDist then minDist = dist; nearest = p end
    end
    return nearest
end

