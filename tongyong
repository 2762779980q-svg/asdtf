-- Keybinds
UIS.InputBegan:Connect(function(input,processed) if processed then return end; if input.KeyCode==Enum.KeyCode.Z and State.isRunKeyEnabled then toggleSpeed(not speedActive) elseif input.KeyCode==Enum.KeyCode.X then toggleFly(not State.flyEnabled)
    elseif input.KeyCode == State.aimMouseToggleKey then toggleMouseAim()
    elseif input.UserInputType == Enum.UserInputType.MouseButton2 then State.aimMouseRightHeld = true; if State.aimMouseEnabled and State.aimMouseMode == "Camera" then State.aimMouseTarget = getClosestPlayerToMouse() end
end end)
UIS.InputEnded:Connect(function(input) if input.UserInputType==Enum.UserInputType.MouseButton2 then State.aimMouseRightHeld=false; State.aimMouseTarget=nil; releaseAimAutoFire() end end)

