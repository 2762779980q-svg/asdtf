-- Hitbox Expander (范围)
for _, partName in ipairs(State.hitboxBodyParts) do State.hitboxSizes[partName] = 0 end
local function hitboxSaveProps(part)
    if part and not State.hitboxOriginalProps[part] then
        State.hitboxOriginalProps[part] = {Size = part.Size, Transparency = part.Transparency, CanCollide = part.CanCollide, Massless = part.Massless}
    end
end
local function hitboxRestoreProps(part)
    local p = State.hitboxOriginalProps[part]
    if p then part.Size = p.Size; part.Transparency = p.Transparency; part.CanCollide = p.CanCollide; part.Massless = p.Massless end
end
local function applyHitboxMod(part, size)
    if not part then return end; hitboxSaveProps(part)
    if size <= 0.01 then hitboxRestoreProps(part); return end
    local s = math.max(size, 0.1); part.Size = Vector3.new(s, s, s); part.Transparency = 0.5; part.CanCollide = false; part.Massless = true
end
local function applyHitboxModWithVisibility(part, size, isPlayer)
    if not part then return end; hitboxSaveProps(part)
    if size <= 0.01 then hitboxRestoreProps(part); return end
    local show = isPlayer and State.hitboxShowPlayerBox or State.hitboxShowNPCBox
    local s = math.max(size, 0.1); part.Size = Vector3.new(s, s, s)
    part.Transparency = show and 0.5 or 1; part.CanCollide = false; part.Massless = true
end
local function updateHitboxChar(character)
    if not character or not State.hitboxEnabled then return end
    local h = character:FindFirstChildOfClass("Humanoid"); if not h or h.Health <= 0 then return end
    local isPlayer = Players:GetPlayerFromCharacter(character) ~= nil
    for partName, size in pairs(State.hitboxSizes) do
        local part = character:FindFirstChild(partName)
        if part then applyHitboxModWithVisibility(part, size, isPlayer) end
    end
end
local function updateAllHitboxes()
    if not State.hitboxEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then updateHitboxChar(p.Character) end
    end
end
local function refreshHitboxVisibility()
    if not State.hitboxEnabled then return end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then updateHitboxChar(p.Character) end
    end
end
local function setupHitboxTracking(targetPlayer)
    if targetPlayer == player then return end
    targetPlayer.CharacterAdded:Connect(function(c)
        task.wait(0.5); updateHitboxChar(c)
        local h = c:WaitForChild("Humanoid")
        h:GetPropertyChangedSignal("Health"):Connect(function()
            if h.Health > 0 then task.wait(0.2); updateHitboxChar(c) end
        end)
    end)
    if targetPlayer.Character then updateHitboxChar(targetPlayer.Character) end
end
local function resetAllHitboxes()
    for partName, _ in pairs(State.hitboxSizes) do State.hitboxSizes[partName] = 0 end
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= player and p.Character then
            local c = p.Character; local h = c:FindFirstChildOfClass("Humanoid")
            if h and h.Health > 0 then
                for partName in pairs(State.hitboxSizes) do
                    local part = c:FindFirstChild(partName)
                    if part then hitboxRestoreProps(part) end
                end
            end
        end
    end
end

-- Hitbox Range Display
local function createHitboxRangeCircle()
    if not Drawing then return nil end
    local c = Drawing.new("Circle")
    c.Visible = false; c.Thickness = 1.5; c.Radius = 5; c.Filled = false
    c.Color = Color3.fromRGB(255, 255, 0); c.Transparency = 0.7
    return c
end

local function toggleHitboxRangeDisplay(enabled)
    State.hitboxShowRange = enabled
    if not enabled then
        if State.hitboxRangeConnection then
            State.hitboxRangeConnection:Disconnect(); State.hitboxRangeConnection = nil
        end
        for _, circles in pairs(State.hitboxRangeCircles) do for _, circ in pairs(circles) do pcall(function() circ:Remove() end) end end
        State.hitboxRangeCircles = {}
        return
    end
    for _, p in ipairs(Players:GetPlayers()) do
        if p == player then continue end
        local circles = {}
        for _, partName in ipairs(State.hitboxBodyParts) do
            local c = createHitboxRangeCircle(); circles[partName] = c
        end
        State.hitboxRangeCircles[p] = circles
    end
    State.hitboxRangeConnection = RunService.Heartbeat:Connect(function()
        for p, circles in pairs(State.hitboxRangeCircles) do
            local tc = p.Character
            if not tc then for _, c in pairs(circles) do c.Visible = false end; continue end
            local h = tc:FindFirstChildOfClass("Humanoid")
            if not h or h.Health <= 0 then for _, c in pairs(circles) do c.Visible = false end; continue end
            for partName, circ in pairs(circles) do
                local part = tc:FindFirstChild(partName)
                local size = State.hitboxSizes[partName]
                if part and size and size > 0 then
                    local sp, on = camera:WorldToViewportPoint(part.Position)
                    if on then
                        circ.Visible = true; circ.Position = Vector2.new(sp.X, sp.Y)
                        circ.Radius = size * 0.5
                        circ.Thickness = 1 + size * 0.04
                    else
                        circ.Visible = false
                    end
                else
                    circ.Visible = false
                end
            end
        end
    end)
end

local function addHitboxRangeCircleForPlayer(p)
