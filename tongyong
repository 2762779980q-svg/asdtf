-- Smart Wall Phase
local function isWallPart(part)
    if not part or not part:IsA("BasePart") or not part.CanCollide then return false end
    for _,plr in ipairs(Players:GetPlayers()) do if plr.Character and part:IsDescendantOf(plr.Character) then return false end end
    local s=part.Size; if s.Y<2 and (s.X>10 or s.Z>10) then return false end; return part.Transparency<=0.9
end

local function restoreAllWalls()
    for part,data in pairs(State.wallPhaseSettings.processedWalls) do pcall(function() if part and part.Parent then part.CanCollide=data.originalCanCollide end end) end
    State.wallPhaseSettings.processedWalls={}
end

local function cleanupWallCache()
    local ct=tick(); if ct-State.wallPhaseSettings.lastCleanupTime<1 then return end; State.wallPhaseSettings.lastCleanupTime=ct
    for part,data in pairs(State.wallPhaseSettings.processedWalls) do if not part or not part.Parent then State.wallPhaseSettings.processedWalls[part]=nil
        elseif ct-data.lastProcessed>State.wallPhaseSettings.wallCacheTimeout then pcall(function() if part and part.Parent then part.CanCollide=data.originalCanCollide end end); State.wallPhaseSettings.processedWalls[part]=nil end end
end

local function enableWallPhase()
    local c=char(); if not c then return end; local head=c:FindFirstChild("Head"); if not head then return end
    local origin=head.Position+Vector3.new(0,State.wallPhaseSettings.headHeightOffset,0)
    local rp=RaycastParams.new(); rp.FilterType=Enum.RaycastFilterType.Blacklist; rp.FilterDescendantsInstances={c}
    for i=0,State.wallPhaseSettings.rayCount-1 do local a=(i/State.wallPhaseSettings.rayCount)*math.pi*2; local dir=Vector3.new(math.cos(a),0,math.sin(a))
        local res=workspace:Raycast(origin,dir*State.wallPhaseSettings.rayLength,rp)
        if res and isWallPart(res.Instance) then local part=res.Instance
            if not State.wallPhaseSettings.processedWalls[part] then State.wallPhaseSettings.processedWalls[part]={originalCanCollide=part.CanCollide,lastProcessed=tick()}; part.CanCollide=false
            else State.wallPhaseSettings.processedWalls[part].lastProcessed=tick() end end end; cleanupWallCache()
end

local function toggleNoClip(enabled)
    State.isNoClipEnabled=enabled; if State.noClipConnection then State.noClipConnection:Disconnect(); State.noClipConnection=nil end
    if enabled then State.wallPhaseSettings.processedWalls={}; State.wallPhaseSettings.lastCleanupTime=tick(); local lu=0
        State.noClipConnection=RunService.Heartbeat:Connect(function() if tick()-lu<State.wallPhaseSettings.updateInterval then return end; lu=tick()
            local h=hum(); if not h or h.Health<=0 then if next(State.wallPhaseSettings.processedWalls) then restoreAllWalls() end; return end; enableWallPhase() end) else restoreAllWalls() end
end

