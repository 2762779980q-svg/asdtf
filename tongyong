-- Enhanced Mouse Aimbot (Fully Independent)
local function isAimTargetVisible(targetPos)
    if not State.aimMouseVisibleCheck then return true end
    local c = char(); if not c then return false end
    local ro = camera.CFrame.Position
    local rd = (targetPos - ro).Unit * 1000
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Blacklist
    rayParams.FilterDescendantsInstances = {c}
    local rr = Workspace:Raycast(ro, rd, rayParams)
    if rr then
        local t = State.aimMouseTarget
        if t and t.Character and rr.Instance:IsDescendantOf(t.Character) then return true end
        return false
    end
    return true
end
local function getMousePredictedPosition(targetPart)
    local v = targetPart.AssemblyLinearVelocity or targetPart.Velocity
    if not v or v.Magnitude == 0 then return targetPart.Position end
    return targetPart.Position + v * (State.aimMousePredictionAmount or 0.165)
end
local function getClosestPlayerToMouse()
    local mousePos = UIS:GetMouseLocation()
    local closest, closestDist = nil, State.aimMouseFOVRadius
    for _, tp in ipairs(Players:GetPlayers()) do
        if tp == player then continue end
